{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "node",
        "strict": true,
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["dom", "esnext"],
        "baseUrl": "./",
        "paths": {
            "~/*": ["src/*"],
        },
    },
    "include": ["src", "src/custom.d.ts"]
}
